@{
    ViewData["Title"] = "You2Forge";
}

<div class="mediaforge-container">

    <div class="hero">

        <h1>You2Forge</h1>

        <p>
            Multimedia processing made simple.
        </p>

    </div>

    <div class="download-card">

        <div class="form-group">

            <label for="mediaUrl">
                URL del contenido
            </label>

            <input type="url"
                   id="mediaUrl"
                   class="form-control"
                   placeholder="Pega aquí la URL..."
                   autocomplete="off" />

        </div>

        <div class="options">

            <div class="form-group">

                <label for="format">
                    Formato
                </label>

                <select id="format" class="form-control">

                    <option value="mp3">
                        MP3
                    </option>

                    <option value="mp4">
                        MP4
                    </option>

                </select>

            </div>

            <div class="form-group">

                <label for="quality">
                    Calidad
                </label>

                <select id="quality" class="form-control">

                    <option value="128">
                        128 kbps
                    </option>

                    <option value="192">
                        192 kbps
                    </option>

                    <option value="320">
                        320 kbps
                    </option>

                </select>

            </div>

        </div>

        <button type="button"
                id="processButton"
                class="process-button">

            Procesar

        </button>

        <div id="statusMessage" class="status-message">
            Esperando una URL...
        </div>

    </div>

</div>